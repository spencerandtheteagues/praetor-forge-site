{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harness-lab-intake",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "observability": { "enabled": true },
  "vars": {
    // Where a submitted lead lands. Change and redeploy to reroute.
    // Gmail rather than the domain mailbox: a lead that is missed is worse than
    // one that arrives at a less tidy address.
    "LEAD_EMAIL_TO": "spencerandtheteagues@gmail.com",
    // Must be on a domain verified in Resend, or the API rejects the send.
    "LEAD_EMAIL_FROM": "intake@theharnesslab.com",
    "ALLOWED_ORIGIN": ""
  },
  "ratelimits": [
    {
      "name": "INTAKE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
}
