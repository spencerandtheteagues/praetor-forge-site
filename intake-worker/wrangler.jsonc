    "LEAD_EMAIL_FROM": "intake@theharnesslab.com",
    "ALLOWED_ORIGIN": "",
    "HARNESSLAB_ELEVENLABS_AGENT_ID": "agent_0901m8cxashwf5abkjd10be1v2qe",
