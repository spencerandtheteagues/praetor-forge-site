{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harness-lab-intake",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "observability": { "enabled": true },
  "vars": {
    // Not a secret: a Telegram chat id is useless without the bot token, which
    // is set with `wrangler secret put TELEGRAM_BOT_TOKEN` and never committed.
    "LEAD_CHAT_ID": "-5036189020",
    "ALLOWED_ORIGIN": ""
  },
  "ratelimits": [
    {
      "name": "INTAKE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
}
